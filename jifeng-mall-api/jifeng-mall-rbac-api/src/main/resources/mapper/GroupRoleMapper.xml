<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.situ.jifeng.rbac.mapper.GroupRoleMapper">

    <!-- 通用查询列 -->
    <sql id="Base_Select">
        select id,
               group_id,
               role_id
        from t_rbac_group_role
    </sql>

    <!-- 查询所有组角色关联 -->
    <select id="findAll" resultType="GroupRoleEntity">
        <include refid="Base_Select"/>
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="groupId != null">
                and group_id = #{groupId}
            </if>
            <if test="roleId != null">
                and role_id = #{roleId}
            </if>
        </where>
        order by id
    </select>

    <select id="findById" resultType="GroupRoleEntity">
        <include refid="Base_Select"/>
        where id = #{id}
    </select>

    <select id="findByGroupId" resultType="GroupRoleEntity">
        <include refid="Base_Select"/>
        where group_id = #{groupId}
        order by id
    </select>

    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        insert into t_rbac_group_role (group_id, role_id)
        values (#{groupId}, #{roleId})
    </insert>

    <update id="update">
        update t_rbac_group_role
        <set>
            <if test="groupId!=null">group_id = #{groupId},</if>
            <if test="roleId!=null">role_id = #{roleId},</if>
        </set>
        where id = #{id}
    </update>

    <delete id="deleteByIds">
        delete from t_rbac_group_role
        where id in
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
